# Copy this file to .env and fill in your keys. NEVER commit .env to GitHub.

# Groq (free LLM): create key at https://console.groq.com/keys
GROQ_API_KEY=paste_your_groq_key_here

# Embeddings run locally via sentence-transformers — no second API key needed.

# Aiven MySQL (free): copy from Aiven service "Connection information" panel
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin password for the Admin page
ADMIN_PASSWORD=college123
